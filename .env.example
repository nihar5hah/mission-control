# Mission Control - Environment Variables Template

# =============================================
# SUPABASE CONFIGURATION (Required)
# =============================================
# Get these from: https://supabase.com/dashboard/project/[project-id]/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (keep secret, use only on backend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================
# GITHUB INTEGRATION (Optional)
# =============================================
# Create at: https://github.com/settings/tokens

# GitHub personal access token for fetching repos, issues, PRs
# Requires: repo, gist, read:user scopes
GITHUB_TOKEN=ghp_your_token_here

# =============================================
# VERCEL INTEGRATION (Optional)
# =============================================
# Create at: https://vercel.com/account/tokens

# Vercel API token for deployments and project data
VERCEL_TOKEN=your_vercel_token_here

# Your Vercel team ID (found in team settings)
VERCEL_TEAM_ID=your_team_id_here

# =============================================
# CALENDAR INTEGRATION (Optional)
# =============================================
# Google Calendar, Outlook, or other calendar service

CALENDAR_API_KEY=your_calendar_api_key
CALENDAR_PROVIDER=google  # or "outlook", "caldav"

# =============================================
# WORKSPACE CONFIGURATION
# =============================================

# Path to your OpenClaw workspace
WORKSPACE_PATH=/home/hyper/.openclaw/workspace

# Your project name
PROJECT_NAME=Mission Control

# =============================================
# OPENCLAW INTEGRATION
# =============================================

# OpenClaw API endpoint
OPENCLAW_API_URL=http://localhost:3001

# OpenClaw API key for agent communication
OPENCLAW_API_KEY=your_openclaw_api_key

# Agent identifier
AGENT_ID=main

# =============================================
# FEATURES & BEHAVIOR
# =============================================

# Enable debug logging
DEBUG=false
LOG_LEVEL=info  # debug, info, warn, error

# Enable proactive intelligence features
ENABLE_PROACTIVE_INTELLIGENCE=true

# Auto-analyze patterns (runs periodically)
AUTO_ANALYZE_PATTERNS=true

# Auto-find opportunities
AUTO_FIND_OPPORTUNITIES=true

# Pattern analysis frequency (in minutes)
PATTERN_ANALYSIS_INTERVAL=60

# Opportunity finding frequency (in hours)
OPPORTUNITY_FINDING_INTERVAL=24

# =============================================
# NOTIFICATIONS
# =============================================

# Enable notifications
ENABLE_NOTIFICATIONS=true

# Notification channels: 'email', 'slack', 'discord', 'telegram'
NOTIFICATION_CHANNELS=

# Email configuration (if using email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=

# Discord webhook for notifications (optional)
DISCORD_WEBHOOK_URL=

# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================
# PERFORMANCE
# =============================================

# Maximum activities to fetch
MAX_ACTIVITIES=500

# Cache TTL in seconds
CACHE_TTL=300

# Database connection pool size
DB_POOL_SIZE=10

# API rate limit (requests per minute)
RATE_LIMIT=60

# =============================================
# SECURITY
# =============================================

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Session timeout (in minutes)
SESSION_TIMEOUT=60

# Enable HTTPS only
HTTPS_ONLY=true

# Secret key for session encryption
SESSION_SECRET=your_very_secure_random_secret_here

# =============================================
# DEPLOYMENT
# =============================================

# Environment: development, staging, production
NODE_ENV=development

# API base URL
API_BASE_URL=http://localhost:3000

# Frontend URL (for CORS, redirects)
FRONTEND_URL=http://localhost:3000

# Database URL (if not using Supabase)
DATABASE_URL=

# =============================================
# OPTIONAL: ANALYTICS
# =============================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# Sentry DSN for error tracking
SENTRY_DSN=

# =============================================
# DEVELOPMENT
# =============================================

# Enable hot reload
NEXT_PUBLIC_HOT_RELOAD=true

# Enable source maps
NEXT_PUBLIC_SOURCE_MAPS=true

# Mock data for development
USE_MOCK_DATA=false
