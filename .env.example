# Convex Configuration
# Get these values from your Convex dashboard at https://dashboard.convex.dev

# Your Convex deployment URL (e.g., https://your-team.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Internal Convex API key (for server-side functions)
CONVEX_DEPLOYMENT=

# Optional: OpenClaw Integration
NEXT_PUBLIC_OPENCLAW_URL=
OPENCLAW_API_KEY=

# Optional: Email/Notification Settings
NEXT_PUBLIC_ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Optional: Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_ID=

# Node Environment
NODE_ENV=development
